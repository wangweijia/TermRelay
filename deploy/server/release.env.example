# On first deployment, deploy.sh copies this template to .env.production in
# the parent release directory. All extracted versions share that one file.
DB_HOST=192.168.8.134
DB_PORT=3306
DB_NAME=termrelay_prod
DB_USER=appuser
DB_PASSWORD=replace-with-runtime-password

# Used only by the one-off migration container. The long-running Server does
# not receive these two variables.
DB_MIGRATION_USER=root
DB_MIGRATION_PASSWORD=replace-with-one-off-migration-password

SERVER_BIND_ADDRESS=0.0.0.0
SERVER_PORT=3006
TERMINAL_EVENT_TTL_HOURS=24
WEB_MAX_SESSION_SUBSCRIPTIONS=16
WEB_MAX_REPLAY_EVENTS=10000
COMMAND_ACK_TIMEOUT_MS=15000

# Reserved for the later Cloudflare Access integration.
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=
