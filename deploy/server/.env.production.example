TERMRELAY_VERSION=latest
DB_HOST=192.168.8.134
DB_PORT=3306
DB_NAME=termrelay_prod
DB_USER=appuser
DB_PASSWORD=replace-with-runtime-password
TERMINAL_EVENT_TTL_HOURS=24
WEB_MAX_SESSION_SUBSCRIPTIONS=16
WEB_MAX_REPLAY_EVENTS=10000
COMMAND_ACK_TIMEOUT_MS=15000

# Only export these for the one-off migration command; do not keep them in the
# long-running Server container.
DB_MIGRATION_USER=root
DB_MIGRATION_PASSWORD=replace-for-one-off-migration

CF_ACCESS_AUD=replace-me
CF_ACCESS_TEAM_DOMAIN=https://replace-me.cloudflareaccess.com
