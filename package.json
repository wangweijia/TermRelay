{
  "name": "termrelay",
  "private": true,
  "packageManager": "pnpm@12.2.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @termrelay/contracts build && pnpm --filter @termrelay/server build && pnpm --filter @termrelay/web build",
    "check": "pnpm contracts:check && pnpm -r --if-present typecheck && pnpm mac:test",
    "contracts:check": "node scripts/validate-contracts.mjs",
    "dev:server": "pnpm --filter @termrelay/server dev",
    "dev:web": "pnpm --filter @termrelay/web dev",
    "mac:test": "CLANG_MODULE_CACHE_PATH=$PWD/apps/mac/.build/clang-cache SWIFTPM_MODULECACHE_OVERRIDE=$PWD/apps/mac/.build/swiftpm-cache swift test --disable-sandbox --package-path apps/mac",
    "release:server": "bash scripts/build-server-release.sh"
  }
}
