{
  "manifest_version": 3,
  "name": "点点改 · TermRelay",
  "version": "0.1.0",
  "description": "围绕当前网页与绑定的 TermRelay AI 会话对话，支持提问、分析交互和请求修改，可附加页面元素与截图。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "proxy", "webRequest", "webRequestAuthProvider", "alarms", "scripting", "activeTab"],
  "host_permissions": ["https://page-gateway-local.nioint.com/*", "http://*/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "点点改 · 快捷连接",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://page-gateway-local.nioint.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
