PORT=3007
HOST=0.0.0.0
NODE_ENV=development
CLIENT_HEARTBEAT_INTERVAL_MS=15000
CLIENT_HEARTBEAT_TIMEOUT_MS=45000
CLIENT_REGISTRATION_TIMEOUT_MS=10000
