{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termrelay.local/contracts/ai.schema.json",
  "title": "AI service wire payloads",
  "$defs": {
    "AiInput": {
      "type": "object",
      "properties": {
        "instructions": {
          "type": "string",
          "maxLength": 100000
        },
        "facts": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "AiOutput": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "text",
            "json"
          ]
        },
        "schema": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "AiCapabilities": {
      "type": "object",
      "required": [
        "providers"
      ],
      "properties": {
        "providers": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/AiProviderCapability"
          }
        }
      },
      "additionalProperties": false
    },
    "AiCreate": {
      "type": "object",
      "required": [
        "id",
        "projectId",
        "provider",
        "lifecycle",
        "displayName"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "provider": {
          "enum": [
            "codex",
            "dsh"
          ]
        },
        "lifecycle": {
          "enum": [
            "oneShot",
            "longLived"
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "maxLength": 128
        },
        "effort": {
          "type": "string",
          "maxLength": 32
        },
        "turn": {
          "$ref": "#/$defs/AiTurn"
        }
      },
      "additionalProperties": false
    },
    "AiTurn": {
      "type": "object",
      "required": [
        "id",
        "sessionId",
        "input",
        "output",
        "deadlineAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "input": {
          "$ref": "#/$defs/AiInput"
        },
        "output": {
          "$ref": "#/$defs/AiOutput"
        },
        "deadlineAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "AiControl": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "turnId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    },
    "AiUpdate": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "turnId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "ready",
            "closed",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 262144
        },
        "errorCode": {
          "type": "string",
          "maxLength": 64
        },
        "waitingFor": {
          "enum": [
            "approval",
            "input",
            "none"
          ]
        },
        "model": {
          "type": "string",
          "maxLength": 128
        },
        "effort": {
          "type": "string",
          "maxLength": 32
        }
      },
      "additionalProperties": false
    },
    "AiProviderCapability": {
      "type": "object",
      "required": [
        "provider",
        "capacity",
        "workspaceEnabled"
      ],
      "properties": {
        "provider": {
          "enum": [
            "codex",
            "dsh"
          ]
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "workspaceEnabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "$comment": "HTTP request types also belong to the cross-component contract."
}
