{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termrelay.local/contracts/events/shortcut-create.schema.json",
  "title": "shortcut.create payload",
  "type": "object",
  "required": ["requestId", "id", "name", "description", "directory", "command", "proxyMode", "requiresConfirmation"],
  "properties": {
    "requestId": { "type": "string", "format": "uuid" },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "maxLength": 500 },
    "directory": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "command": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "proxyMode": { "enum": ["inherit", "disabled", "custom"] },
    "httpProxy": { "type": "string", "maxLength": 2048 },
    "httpsProxy": { "type": "string", "maxLength": 2048 },
    "allProxy": { "type": "string", "maxLength": 2048 },
    "noProxy": { "type": "string", "maxLength": 2048 },
    "requiresConfirmation": { "type": "boolean" }
  },
  "additionalProperties": false
}