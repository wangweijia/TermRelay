{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termrelay.local/contracts/events/session-history-listed.schema.json",
  "title": "session.history.listed payload",
  "type": "object",
  "required": ["sessions", "hasMore", "relatedMessageId"],
  "properties": {
    "sessions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "workspaceId", "toolKey", "displayName", "runtimeMode", "status", "startedAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "toolKey": { "type": "string", "minLength": 1, "maxLength": 64 },
          "displayName": { "type": ["string", "null"], "maxLength": 128 },
          "runtimeMode": { "const": "acp" },
          "status": { "enum": ["starting", "running", "stopping", "finished", "failed"] },
          "startedAt": { "type": ["string", "null"], "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "hasMore": { "type": "boolean" },
    "relatedMessageId": { "type": "string", "format": "uuid" },
    "nextCursor": { "type": "string", "minLength": 3, "maxLength": 1024, "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" }
  },
  "additionalProperties": false
}
